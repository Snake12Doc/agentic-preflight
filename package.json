{
  "name": "agentic-preflight",
  "version": "0.3.0",
  "description": "Local quality gates for AI coding agents, available as a CLI and MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "Álvaro Ruiz Zamora",
  "keywords": [
    "mcp",
    "ai-agents",
    "quality-gate",
    "testing",
    "code-review",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentic-preflight": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm test && npm pack --dry-run",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/cli.ts mcp",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
